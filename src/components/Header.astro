---
import Logo from "./Logo.astro";

const {url} = Astro

const slugs:string[] = url.pathname.slice(1,-1).split("/").filter(e=>e!="");

const isRoot = slugs.length == 0
---

<header>
  <Logo />
</header>

<style>
  
  header {
    padding: 1em;
    background-color: var(--bg-secondary);
  }
</style>